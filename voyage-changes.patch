+-- ════════════════════════════════════════════════════════════════════
+-- VOYAGE · Telegram-оповещения резиденток и менеджеров с учётом настроек
+-- supabase/migrations/20261020091000_telegram_notifications.sql
+--
+-- Требует 20261020090000_member_preferences.sql.
+--
+-- Все оповещения идут через уже существующую очередь public.partner_notifications
+-- (её разбирает /api/telegram/notify). Миграция:
+--
+--   1. Новые шаблоны очереди:
+--        резидентка  tour_published · party_published · application_approved · points_awarded
+--        менеджер    casting_response · contract_signed · docs_uploaded · review_received
+--   2. Статус 'sending' + claimed_at: строку забирает один обработчик
+--      (voyage_claim_partner_notification), даже если вебхуки пришли пачкой —
+--      без дублей в Telegram.
+--   3. voyage_notification_allowed() — тумблер из member_preferences.
+--      partner_queue_notification() кладёт строку со статусом skipped / opted_out,
+--      если участница отключила этот вид оповещений. Служебные письма
+--      (договор, документы, KYC, ссылка входа) не отключаются.
+--   4. Триггеры-источники:
+--        applications / event_applications → approved   application_approved
+--        partner_casting_responses → selected             application_approved (кастинг)
+--        resident_score_events (+баллы)                   points_awarded, одно сообщение на транзакцию
+--        map_hubs стал активным                           tour_published  (working, approved)
+--        global_events стал активным                      party_published (сегмент, уровень, KYC)
+--        partner_casting_responses → ready                casting_response (не чаще раза в 30 мин на кастинг)
+--        partner_contract_signatures (не менеджер)        contract_signed
+--        partner_events kind = docs_uploaded              docs_uploaded
+--        partner_reviews resident_to_manager published    review_received (анонимно)
+--
+-- Рассылка о новом туре/тусовке не создаёт строк для тех, у кого нет Telegram
+-- или оповещение выключено, и не повторяется для той же локации/тусовки 7 дней.
+-- ════════════════════════════════════════════════════════════════════
+
+begin;
+
+/* ── 1–2. Очередь: шаблоны, статус sending ──────────────────────────── */
+
+alter table public.partner_notifications
+  add column if not exists claimed_at timestamptz;
+
+alter table public.partner_notifications drop constraint if exists partner_notifications_template_check;
+alter table public.partner_notifications add constraint partner_notifications_template_check check (template = any (array[
+  'contract_sign_request', 'contract_reminder', 'docs_reminder', 'kyc_approved', 'access_link',
+  'tour_published', 'party_published', 'application_approved', 'points_awarded',
+  'casting_response', 'contract_signed', 'docs_uploaded', 'review_received'
+]::text[]));
+
+alter table public.partner_notifications drop constraint if exists partner_notifications_status_check;
+alter table public.partner_notifications add constraint partner_notifications_status_check check (status = any (array[
+  'queued', 'sending', 'sent', 'failed', 'skipped'
+]::text[]));
+
+create index if not exists partner_notifications_dedupe_idx
+  on public.partner_notifications (template, recipient_id, ((payload ->> 'ref_id')), created_at desc);
+
+-- Забрать строку на отправку. Возвращает строку, только если этот вызов её «взял».
+-- Повисшие в sending дольше 10 минут (упал процесс) снова доступны.
+create or replace function public.voyage_claim_partner_notification(p_id uuid, p_include_failed boolean default false)
+returns setof public.partner_notifications
+language sql security definer
+set search_path to ''
+as $$
+  update public.partner_notifications n
+     set status = 'sending', claimed_at = now()
+   where n.id = p_id
+     and n.attempts < 3
+     and (
+       n.status = 'queued'
+       or (p_include_failed and n.status = 'failed')
+       or (n.status = 'sending' and n.claimed_at < now() - interval '10 minutes')
+     )
+  returning n.*
+$$;
+
+revoke all on function public.voyage_claim_partner_notification(uuid, boolean) from public, anon, authenticated;
+grant execute on function public.voyage_claim_partner_notification(uuid, boolean) to service_role;
+
+/* ── 3. Настройки → можно ли слать ─────────────────────────────────── */
+
+create or replace function public.voyage_notification_allowed(p_recipient uuid, p_template text)
+returns boolean
+language sql stable security definer
+set search_path to ''
+as $$
+  select coalesce((
+    select case p_template
+             when 'tour_published'       then mp.notify_tours
+             when 'party_published'      then mp.notify_parties
+             when 'application_approved' then mp.notify_approvals
+             when 'points_awarded'       then mp.notify_points
+             when 'casting_response'     then mp.notify_casting_responses
+             when 'contract_signed'      then mp.notify_contract_signed
+             when 'docs_uploaded'        then mp.notify_docs_uploaded
+             when 'review_received'      then mp.notify_reviews
+             else true
+           end
+    from public.member_preferences mp
+    where mp.profile_id = p_recipient
+  ), true)
+$$;
+
+revoke all on function public.voyage_notification_allowed(uuid, text) from public, anon;
+grant execute on function public.voyage_notification_allowed(uuid, text) to authenticated, service_role;
+
+create or replace function public.partner_queue_notification(p_recipient uuid, p_template text, p_tour uuid, p_payload jsonb, p_created_by uuid)
+returns text
+language plpgsql security definer
+set search_path to ''
+as $$
+declare
+  v_error text := case
+    when not public.voyage_notification_allowed(p_recipient, p_template) then 'opted_out'
+    when not public.partner_has_telegram(p_recipient) then 'no_telegram'
+  end;
+  v_status text := case when v_error is null then 'queued' else 'skipped' end;
+begin
+  insert into public.partner_notifications (recipient_id, template, tour_id, payload, status, error, created_by)
+  values (p_recipient, p_template, p_tour, coalesce(p_payload, '{}'::jsonb), v_status, v_error, p_created_by);
+  return v_status;
+end;
+$$;
+
+revoke all on function public.partner_queue_notification(uuid, text, uuid, jsonb, uuid) from public, anon, authenticated;
+grant execute on function public.partner_queue_notification(uuid, text, uuid, jsonb, uuid) to service_role;
+
+-- Тихая версия для массовых и второстепенных событий: если слать некому —
+-- строку не создаёт (лишняя строка = лишний вызов вебхука).
+create or replace function public.voyage_queue_if_allowed(p_recipient uuid, p_template text, p_tour uuid, p_payload jsonb)
+returns boolean
+language plpgsql security definer
+set search_path to ''
+as $$
+begin
+  if p_recipient is null
+     or not public.voyage_notification_allowed(p_recipient, p_template)
+     or not public.partner_has_telegram(p_recipient) then
+    return false;
+  end if;
+  insert into public.partner_notifications (recipient_id, template, tour_id, payload, status, created_by)
+  values (p_recipient, p_template, p_tour, coalesce(p_payload, '{}'::jsonb), 'queued', auth.uid());
+  return true;
+end;
+$$;
+
+revoke all on function public.voyage_queue_if_allowed(uuid, text, uuid, jsonb) from public, anon, authenticated;
+grant execute on function public.voyage_queue_if_allowed(uuid, text, uuid, jsonb) to service_role;
+
+/* ── 4a. Одобрение заявки на тур / тусовку / кастинг ──────────────── */
+
+create or replace function public.voyage_notify_application_approved()
+returns trigger
+language plpgsql security definer
+set search_path to ''
+as $$
+declare
+  v_payload jsonb;
+begin
+  if new.status is distinct from 'approved' or old.status is not distinct from 'approved' then
+    return null;
+  end if;
+
+  if tg_table_name = 'applications' then
+    select jsonb_build_object('kind', 'tour', 'ref_id', h.id, 'title_i18n', h.name, 'region', h.region)
+      into v_payload
+      from public.map_hubs h where h.id = new.hub_id;
+    v_payload := coalesce(v_payload, jsonb_build_object('kind', 'tour', 'ref_id', new.hub_id, 'title', new.hub_id));
+  else
+    select jsonb_build_object('kind', 'party', 'ref_id', e.id, 'title', e.title, 'region', e.region)
+      into v_payload
+      from public.global_events e where e.id = new.event_id;
+    v_payload := coalesce(v_payload, jsonb_build_object('kind', 'party', 'ref_id', new.event_id));
+  end if;
+
+  perform public.voyage_queue_if_allowed(new.user_id, 'application_approved', null, v_payload);
+  return null;
+end;
+$$;
+
+drop trigger if exists voyage_notify_application_approved on public.applications;
+create trigger voyage_notify_application_approved
+  after update of status on public.applications
+  for each row when (new.status = 'approved' and old.status is distinct from 'approved')
+  execute function public.voyage_notify_application_approved();
+
+drop trigger if exists voyage_notify_application_approved on public.event_applications;
+create trigger voyage_notify_application_approved
+  after update of status on public.event_applications
+  for each row when (new.status = 'approved' and old.status is distinct from 'approved')
+  execute function public.voyage_notify_application_approved();
+
+/* ── 4b. Отклики на кастинг: менеджеру — новый «Готова», резидентке — «выбрана» ── */
+
+create or replace function public.voyage_notify_casting_response()
+returns trigger
+language plpgsql security definer
+set search_path to ''
+as $$
+declare
+  c public.partner_castings%rowtype;
+  v_tour uuid;
+begin
+  select * into c from public.partner_castings where id = new.casting_id;
+  if not found then return null; end if;
+
+  -- Резидентку выбрали (рукопожатие): она в составе тура
+  if new.status = 'selected' and (tg_op = 'INSERT' or old.status is distinct from 'selected') then
+    select t.id into v_tour from public.partner_tours t
+     where t.casting_id = c.id order by t.created_at desc limit 1;
+    perform public.voyage_queue_if_allowed(new.resident_id, 'application_approved', v_tour,
+      jsonb_build_object('kind', 'casting', 'ref_id', c.id, 'city', c.city, 'project', c.project_type,
+                         'starts_on', c.starts_on, 'ends_on', c.ends_on));
+    return null;
+  end if;
+
+  -- Новый отклик «Готова» → менеджеру кастинга, не чаще раза в 30 минут на кастинг
+  if new.status = 'ready' and (tg_op = 'INSERT' or old.status is distinct from 'ready')
+     and not public.partner_is_blacklisted(new.resident_id)
+     and c.status in ('open', 'shortlist')
+     and not exists (
+       select 1 from public.partner_notifications n
+        where n.recipient_id = c.manager_id and n.template = 'casting_response'
+          and n.payload ->> 'ref_id' = c.id::text
+          and n.status in ('queued', 'sending', 'sent')
+          and n.created_at > now() - interval '30 minutes'
+     ) then
+    perform public.voyage_queue_if_allowed(c.manager_id, 'casting_response', null,
+      jsonb_build_object(
+        'ref_id', c.id, 'city', c.city, 'project', c.project_type,
+        'code', public.partner_blind_code(new.id),
+        'count', (select count(*) from public.partner_casting_responses r
+                   where r.casting_id = c.id and r.status = 'ready'
+                     and r.created_at > c.manager_seen_at
+                     and not public.partner_is_blacklisted(r.resident_id)),
+        'slots', c.slots
+      ));
+  end if;
+  return null;
+end;
+$$;
+
+drop trigger if exists voyage_notify_casting_response on public.partner_casting_responses;
+create trigger voyage_notify_casting_response
+  after insert or update of status on public.partner_casting_responses
+  for each row execute function public.voyage_notify_casting_response();
+
+/* ── 4c. Начисление баллов: одно сообщение на транзакцию ──────────── */
+
+create or replace function public.voyage_notify_points_awarded()
+returns trigger
+language plpgsql security definer
+set search_path to ''
+as $$
+declare
+  v_row public.partner_notifications%rowtype;
+  v_label text := coalesce(nullif(new.metadata ->> 'source_label', ''), new.reason);
+begin
+  if new.points <= 0 then return null; end if;
+  if not exists (select 1 from public.profiles p where p.id = new.profile_id and p.role = 'resident') then
+    return null;
+  end if;
+
+  -- Тур закрыт → тур + штамп + комбо + ачивка приходят в одной транзакции.
+  -- Складываем их в одно сообщение: now() одинаков в пределах транзакции.
+  select * into v_row from public.partner_notifications n
+   where n.recipient_id = new.profile_id and n.template = 'points_awarded'
+     and n.status = 'queued' and n.created_at = now()
+   order by n.created_at desc
+   limit 1
+   for update;
+
+  if found then
+    update public.partner_notifications n
+       set payload = jsonb_build_object(
+             'points', coalesce((v_row.payload ->> 'points')::int, 0) + new.points,
+             'items', coalesce(v_row.payload -> 'items', '[]'::jsonb)
+                      || jsonb_build_array(jsonb_build_object('category', new.category, 'points', new.points, 'label', v_label)),
+             'activity_id', coalesce(v_row.payload ->> 'activity_id', new.activity_id::text)
+           )
+     where n.id = v_row.id;
+  else
+    perform public.voyage_queue_if_allowed(new.profile_id, 'points_awarded', null,
+      jsonb_build_object(
+        'points', new.points,
+        'items', jsonb_build_array(jsonb_build_object('category', new.category, 'points', new.points, 'label', v_label)),
+        'activity_id', new.activity_id
+      ));
+  end if;
+  return null;
+end;
+$$;
+
+drop trigger if exists voyage_notify_points_awarded on public.resident_score_events;
+create trigger voyage_notify_points_awarded
+  after insert on public.resident_score_events
+  for each row when (new.points > 0)
+  execute function public.voyage_notify_points_awarded();
+
+/* ── 4d. Новый тур на карте → working-резиденткам ─────────────────── */
+
+create or replace function public.voyage_notify_tour_published()
+returns trigger
+language plpgsql security definer
+set search_path to ''
+as $$
+begin
+  if coalesce(new.is_active, true) is not true then return null; end if;
+  if tg_op = 'UPDATE' and coalesce(old.is_active, true) is true then return null; end if;
+
+  insert into public.partner_notifications (recipient_id, template, payload, status, created_by)
+  select p.id, 'tour_published',
+         jsonb_build_object('ref_id', new.id, 'title_i18n', new.name, 'subtitle_i18n', new.subtitle, 'region', new.region),
+         'queued', auth.uid()
+    from public.profiles p
+   where p.role = 'resident'
+     and p.status = 'approved'
+     and p.segment = 'working'
+     and not coalesce(p.is_npc, false)
+     and nullif(btrim(p.telegram_id), '') is not null
+     and public.voyage_notification_allowed(p.id, 'tour_published')
+     and not exists (
+       select 1 from public.partner_notifications n
+        where n.template = 'tour_published' and n.recipient_id = p.id
+          and n.payload ->> 'ref_id' = new.id
+          and n.created_at > now() - interval '7 days'
+     );
+  return null;
+end;
+$$;
+
+drop trigger if exists voyage_notify_tour_published on public.map_hubs;
+create trigger voyage_notify_tour_published
+  after insert or update of is_active on public.map_hubs
+  for each row execute function public.voyage_notify_tour_published();
+
+/* ── 4e. Новая тусовка → кому она доступна ────────────────────────── */
+
+create or replace function public.voyage_notify_party_published()
+returns trigger
+language plpgsql security definer
+set search_path to ''
+as $$
+begin
+  if new.is_active is not true then return null; end if;
+  if tg_op = 'UPDATE' and old.is_active is true then return null; end if;
+  if new.application_closes_at is not null and new.application_closes_at <= now() then return null; end if;
+
+  insert into public.partner_notifications (recipient_id, template, payload, status, created_by)
+  select p.id, 'party_published',
+         jsonb_build_object('ref_id', new.id, 'title', new.title, 'region', new.region,
+                            'closes_at', new.application_closes_at),
+         'queued', auth.uid()
+    from public.profiles p
+   where p.role = 'resident'
+     and p.status = 'approved'
+     and not coalesce(p.is_npc, false)
+     and (new.audience_segment = 'all' or p.segment = new.audience_segment)
+     and coalesce(p.level, 1) >= new.minimum_level
+     and coalesce(p.kyc_level, 0) >= new.minimum_kyc_level
+     and nullif(btrim(p.telegram_id), '') is not null
+     and public.voyage_notification_allowed(p.id, 'party_published')
+     and not exists (
+       select 1 from public.partner_notifications n
+        where n.template = 'party_published' and n.recipient_id = p.id
+          and n.payload ->> 'ref_id' = new.id::text
+          and n.created_at > now() - interval '7 days'
+     );
+  return null;
+end;
+$$;
+
+drop trigger if exists voyage_notify_party_published on public.global_events;
+create trigger voyage_notify_party_published
+  after insert or update of is_active on public.global_events
+  for each row execute function public.voyage_notify_party_published();
+
+/* ── 4f. Менеджеру: подпись договора участницей ───────────────────── */
+
+create or replace function public.voyage_notify_contract_signed()
+returns trigger
+language plpgsql security definer
+set search_path to ''
+as $$
+declare
+  v_contract public.partner_contracts%rowtype;
+  t public.partner_tours%rowtype;
+  v_signed int;
+  v_required int;
+begin
+  select * into v_contract from public.partner_contracts where id = new.contract_id;
+  if not found then return null; end if;
+  select * into t from public.partner_tours where id = v_contract.tour_id;
+  if not found or new.signer_id = t.manager_id then return null; end if;
+
+  select count(*)::int + 1 into v_required
+    from public.partner_tour_members m
+   where m.tour_id = t.id and m.status in ('confirmed', 'flown');
+  select count(*)::int into v_signed
+    from public.partner_contract_signatures s
+   where s.contract_id = v_contract.id
+     and (s.signer_id = t.manager_id or s.signer_id in (
+           select m.resident_id from public.partner_tour_members m
+            where m.tour_id = t.id and m.status in ('confirmed', 'flown')));
+
+  perform public.voyage_queue_if_allowed(t.manager_id, 'contract_signed', t.id,
+    jsonb_build_object(
+      'ref_id', t.id, 'city', t.city, 'project', t.project_type, 'departs_at', t.departs_at,
+      'version', v_contract.version, 'signed', v_signed, 'required', v_required,
+      'name', (select public.partner_short_name(p.full_name) from public.profiles p where p.id = new.signer_id)
+    ));
+  return null;
+end;
+$$;
+
+drop trigger if exists voyage_notify_contract_signed on public.partner_contract_signatures;
+create trigger voyage_notify_contract_signed
+  after insert on public.partner_contract_signatures
+  for each row execute function public.voyage_notify_contract_signed();
+
+/* ── 4g. Менеджеру: участница загрузила документы ─────────────────── */
+
+create or replace function public.voyage_notify_docs_uploaded()
+returns trigger
+language plpgsql security definer
+set search_path to ''
+as $$
+declare
+  t public.partner_tours%rowtype;
+begin
+  select * into t from public.partner_tours where id = new.tour_id;
+  if not found or coalesce(new.actor_id, new.subject_id) = t.manager_id then return null; end if;
+
+  perform public.voyage_queue_if_allowed(t.manager_id, 'docs_uploaded', t.id,
+    jsonb_build_object(
+      'ref_id', t.id, 'city', t.city, 'project', t.project_type, 'departs_at', t.departs_at,
+      'name', (select public.partner_short_name(p.full_name) from public.profiles p
+                where p.id = coalesce(new.subject_id, new.actor_id))
+    ));
+  return null;
+end;
+$$;
+
+drop trigger if exists voyage_notify_docs_uploaded on public.partner_events;
+create trigger voyage_notify_docs_uploaded
+  after insert on public.partner_events
+  for each row when (new.kind = 'docs_uploaded')
+  execute function public.voyage_notify_docs_uploaded();
+
+/* ── 4h. Менеджеру: опубликован отзыв резидентки (без имени автора) ── */
+
+create or replace function public.voyage_notify_review_received()
+returns trigger
+language plpgsql security definer
+set search_path to ''
+as $$
+declare
+  t public.partner_tours%rowtype;
+begin
+  if new.direction <> 'resident_to_manager' or new.status <> 'published' then return null; end if;
+  if tg_op = 'UPDATE' and old.status = 'published' then return null; end if;
+
+  select * into t from public.partner_tours where id = new.tour_id;
+  perform public.voyage_queue_if_allowed(new.subject_id, 'review_received', new.tour_id,
+    jsonb_build_object('ref_id', new.id, 'rating', new.rating, 'city', t.city, 'project', t.project_type,
+                       'has_comment', new.comment is not null));
+  return null;
+end;
+$$;
+
+drop trigger if exists voyage_notify_review_received on public.partner_reviews;
+create trigger voyage_notify_review_received
+  after insert or update of status on public.partner_reviews
+  for each row execute function public.voyage_notify_review_received();
+
+-- Триггерные функции не вызываются напрямую
+revoke all on function public.voyage_notify_application_approved() from public, anon, authenticated;
+revoke all on function public.voyage_notify_casting_response() from public, anon, authenticated;
+revoke all on function public.voyage_notify_points_awarded() from public, anon, authenticated;
+revoke all on function public.voyage_notify_tour_published() from public, anon, authenticated;
+revoke all on function public.voyage_notify_party_published() from public, anon, authenticated;
+revoke all on function public.voyage_notify_contract_signed() from public, anon, authenticated;
+revoke all on function public.voyage_notify_docs_uploaded() from public, anon, authenticated;
+revoke all on function public.voyage_notify_review_received() from public, anon, authenticated;
+
+commit;
diff --git a/supabase/migrations/20261020092000_partner_tour_completion_points.sql b/supabase/migrations/20261020092000_partner_tour_completion_points.sql
new file mode 100644
index 0000000..e2b6aa1
--- /dev/null
+++ b/supabase/migrations/20261020092000_partner_tour_completion_points.sql
@@ -0,0 +1,323 @@
+-- ════════════════════════════════════════════════════════════════════
+-- VOYAGE · Баллы за тур менеджера: начисление в момент закрытия комнаты
+-- supabase/migrations/20261020092000_partner_tour_completion_points.sql
+--
+-- Раньше баллы приходили только из applications / event_applications
+-- (status → completed). Туры менеджеров (partner_tours) в рейтинг не попадали.
+--
+-- Теперь:
+--   partner_tours.status → 'closed'  (или 'completed' — нормализуется в 'closed')
+--     каждая участница со статусом 'flown' получает resident_activities
+--     (activity_type 'tour') → resident_process_activity(): баллы по формуле,
+--     штамп страны, комбо, ачивки, пересчёт уровня. Всё — в той же транзакции.
+--   partner_tour_members.status → 'flown' уже после закрытия тура
+--     (админ поправил итог) — начисляется этой участнице.
+--   Повторное закрытие / повторный 'flown' не начисляют дважды:
+--     resident_activities.source_partner_member_id уникален, event_key
+--     'activity:<id>' в ledger тоже.
+--
+--   partner_close_tour(p_tour, p_outcomes, p_country_code) — RPC для кнопки
+--   «Закрыть тур» в комнате: менеджер отмечает, кто долетел, кто сорвался,
+--   и закрывает тур одним вызовом (участниц напрямую менять может только админ).
+--
+-- Формула та же, что для обычных туров:
+--   commercial_value = гонорар из последней версии контракта (terms.fee_amount),
+--                      иначе гонорар кастинга
+--   destination_code = partner_tours.country_code, иначе game_destinations по городу
+--   complexity       = partner_tours.complexity_score (1…3, меняет только админ)
+-- ════════════════════════════════════════════════════════════════════
+
+begin;
+
+/* ── Схема ───────────────────────────────────────────────────────── */
+
+alter table public.partner_tours
+  add column if not exists country_code text,
+  add column if not exists complexity_score numeric(4,2) not null default 1,
+  add column if not exists closed_at timestamptz,
+  add column if not exists closed_by uuid references public.profiles(id) on delete set null;
+
+alter table public.partner_tours drop constraint if exists partner_tours_country_code_check;
+alter table public.partner_tours add constraint partner_tours_country_code_check
+  check (country_code is null or country_code ~ '^[A-Z]{2}$');
+alter table public.partner_tours drop constraint if exists partner_tours_complexity_check;
+alter table public.partner_tours add constraint partner_tours_complexity_check
+  check (complexity_score >= 1 and complexity_score <= 3);
+
+comment on column public.partner_tours.country_code is 'ISO 3166-1 alpha-2 of the tour destination; drives the passport stamp when the tour closes.';
+comment on column public.partner_tours.complexity_score is 'Scoring multiplier 1..3 for closed-tour points. Admin-managed.';
+
+alter table public.resident_activities
+  add column if not exists source_partner_member_id uuid,
+  add column if not exists source_partner_tour_id uuid;
+
+do $$
+begin
+  if not exists (select 1 from pg_constraint where conname = 'resident_activities_source_partner_member_id_fkey') then
+    alter table public.resident_activities
+      add constraint resident_activities_source_partner_member_id_fkey
+      foreign key (source_partner_member_id) references public.partner_tour_members(id) on delete set null;
+  end if;
+  if not exists (select 1 from pg_constraint where conname = 'resident_activities_source_partner_member_id_key') then
+    alter table public.resident_activities
+      add constraint resident_activities_source_partner_member_id_key unique (source_partner_member_id);
+  end if;
+end $$;
+
+create index if not exists resident_activities_partner_tour_idx
+  on public.resident_activities (source_partner_tour_id) where source_partner_tour_id is not null;
+
+-- Ровно один источник. Для тура менеджера: участница или (если тур потом удалили
+-- вместе с составом) хотя бы id тура — баллы в ledger при этом сохраняются.
+alter table public.resident_activities drop constraint if exists resident_activities_one_source_check;
+alter table public.resident_activities add constraint resident_activities_one_source_check check (
+  num_nonnulls(source_application_id, source_event_application_id, source_partner_member_id) = 1
+  or (
+    num_nonnulls(source_application_id, source_event_application_id, source_partner_member_id) = 0
+    and source_partner_tour_id is not null
+  )
+);
+
+/* ── Начисление одной участнице ─────────────────────────────────── */
+
+create or replace function public.voyage_award_partner_member(p_member uuid)
+returns uuid
+language plpgsql security definer
+set search_path to ''
+as $$
+declare
+  m public.partner_tour_members%rowtype;
+  t public.partner_tours%rowtype;
+  v_country text;
+  v_value numeric(12,2);
+  v_reliability numeric(5,2);
+  v_label text;
+  v_activity uuid;
+begin
+  select * into m from public.partner_tour_members where id = p_member;
+  if not found or m.status <> 'flown' then return null; end if;
+  select * into t from public.partner_tours where id = m.tour_id;
+  if not found or t.status <> 'closed' then return null; end if;
+
+  -- Только резидентки клуба
+  if not exists (select 1 from public.profiles p where p.id = m.resident_id and p.role = 'resident') then
+    return null;
+  end if;
+
+  v_country := t.country_code;
+  if v_country is null then
+    select upper(coalesce(nullif(d.country_code, ''), case when d.code ~* '^[A-Z]{2}$' then d.code end))
+      into v_country
+      from public.game_destinations d
+     where d.active and lower(btrim(d.name)) = lower(btrim(t.city))
+     order by d.sort_order
+     limit 1;
+  end if;
+  if v_country !~ '^[A-Z]{2}$' then v_country := null; end if;
+
+  select case when (c.terms ->> 'fee_amount') ~ '^\d+(\.\d+)?$' then (c.terms ->> 'fee_amount')::numeric end
+    into v_value
+    from public.partner_contracts c
+   where c.tour_id = t.id
+   order by c.version desc
+   limit 1;
+  if v_value is null and t.casting_id is not null then
+    select pc.fee_amount into v_value from public.partner_castings pc where pc.id = t.casting_id;
+  end if;
+  v_value := least(greatest(coalesce(v_value, 0), 0), 100000000);
+
+  select coalesce(p.reliability, 100)::numeric(5,2) into v_reliability
+    from public.profiles p where p.id = m.resident_id;
+
+  v_label := t.city || ' · ' || case t.project_type
+    when 'shoot' then 'Съёмка' when 'show' then 'Показ'
+    when 'campaign' then 'Кампейн' when 'event' then 'Ивент' else t.project_type end;
+
+  insert into public.resident_activities (
+    profile_id, activity_type, source_partner_member_id, source_partner_tour_id, source_label,
+    destination_code, commercial_value, complexity_score, reliability_snapshot, completed_by, completed_at
+  ) values (
+    m.resident_id, 'tour', m.id, t.id, v_label,
+    v_country, v_value, greatest(1, least(3, coalesce(t.complexity_score, 1))),
+    coalesce(v_reliability, 100), coalesce(t.closed_by, auth.uid(), t.manager_id), coalesce(t.closed_at, now())
+  )
+  on conflict (source_partner_member_id) do nothing
+  returning id into v_activity;
+
+  if v_activity is not null then
+    perform public.resident_process_activity(v_activity);
+  end if;
+  return v_activity;
+end;
+$$;
+
+revoke all on function public.voyage_award_partner_member(uuid) from public, anon, authenticated;
+grant execute on function public.voyage_award_partner_member(uuid) to service_role;
+
+/* ── Триггеры ────────────────────────────────────────────────────── */
+
+-- 'completed' — синоним 'closed'; фиксируем, кто и когда закрыл
+create or replace function public.partner_tours_before_close()
+returns trigger
+language plpgsql
+set search_path to ''
+as $$
+begin
+  if new.status = 'completed' then
+    new.status := 'closed';
+  end if;
+
+  if new.status = 'closed' and old.status is distinct from 'closed' then
+    new.closed_at := now();
+    new.closed_by := coalesce(auth.uid(), new.closed_by, new.manager_id);
+  elsif old.status = 'closed' and new.status is distinct from 'closed' then
+    raise exception 'voyage:tour_already_closed' using errcode = '23514';
+  end if;
+
+  -- Коэффициент сложности влияет на баллы — его меняет только админ
+  if new.complexity_score is distinct from old.complexity_score
+     and auth.uid() is not null and not coalesce(public.is_admin(), false) then
+    raise exception 'voyage:complexity_admin_only' using errcode = '42501';
+  end if;
+  return new;
+end;
+$$;
+
+drop trigger if exists partner_tours_before_close on public.partner_tours;
+create trigger partner_tours_before_close
+  before update on public.partner_tours
+  for each row execute function public.partner_tours_before_close();
+
+create or replace function public.partner_tours_award_on_close()
+returns trigger
+language plpgsql security definer
+set search_path to ''
+as $$
+declare
+  v_member uuid;
+begin
+  for v_member in
+    select m.id from public.partner_tour_members m
+     where m.tour_id = new.id and m.status = 'flown'
+     order by m.joined_at
+  loop
+    perform public.voyage_award_partner_member(v_member);
+  end loop;
+  return null;
+end;
+$$;
+
+drop trigger if exists partner_tours_award_on_close on public.partner_tours;
+create trigger partner_tours_award_on_close
+  after update of status on public.partner_tours
+  for each row when (new.status = 'closed' and old.status is distinct from 'closed')
+  execute function public.partner_tours_award_on_close();
+
+create or replace function public.partner_members_award_on_flown()
+returns trigger
+language plpgsql security definer
+set search_path to ''
+as $$
+begin
+  perform public.voyage_award_partner_member(new.id);
+  return null;
+end;
+$$;
+
+drop trigger if exists partner_members_award_on_flown on public.partner_tour_members;
+create trigger partner_members_award_on_flown
+  after update of status on public.partner_tour_members
+  for each row when (new.status = 'flown' and old.status is distinct from 'flown')
+  execute function public.partner_members_award_on_flown();
+
+revoke all on function public.partner_tours_award_on_close() from public, anon, authenticated;
+revoke all on function public.partner_members_award_on_flown() from public, anon, authenticated;
+
+/* ── RPC «Закрыть тур» ───────────────────────────────────────────── */
+
+-- p_outcomes: {"<resident_id>": "flown" | "late_drop" | "no_show" | "released", ...}
+-- Участницы со статусом confirmed, которых нет в p_outcomes, считаются долетевшими.
+create or replace function public.partner_close_tour(
+  p_tour uuid,
+  p_outcomes jsonb default '{}'::jsonb,
+  p_country_code text default null
+)
+returns jsonb
+language plpgsql security definer
+set search_path to ''
+as $$
+declare
+  me uuid := auth.uid();
+  v_admin boolean := coalesce(public.is_admin(), false);
+  t public.partner_tours%rowtype;
+  v_country text := nullif(upper(btrim(coalesce(p_country_code, ''))), '');
+  v_key text;
+  v_value text;
+  v_flown int;
+  v_dropped int;
+  v_points int;
+begin
+  if me is null or not coalesce(public.has_role('manager', 'admin', 'owner'), false) then
+    raise exception 'voyage:forbidden' using errcode = '42501';
+  end if;
+  if p_outcomes is not null and jsonb_typeof(p_outcomes) <> 'object' then
+    raise exception 'voyage:invalid_outcomes' using errcode = '22023';
+  end if;
+  if v_country is not null and v_country !~ '^[A-Z]{2}$' then
+    raise exception 'voyage:invalid_country' using errcode = '22023';
+  end if;
+
+  select * into t from public.partner_tours where id = p_tour for update;
+  if not found then raise exception 'voyage:tour_not_found' using errcode = 'P0002'; end if;
+  if not v_admin and t.manager_id <> me then
+    raise exception 'voyage:forbidden_owner' using errcode = '42501';
+  end if;
+  if t.status = 'closed' then
+    raise exception 'voyage:tour_already_closed' using errcode = 'P0001';
+  end if;
+  if t.status = 'cancelled' then
+    raise exception 'voyage:tour_cancelled' using errcode = 'P0001';
+  end if;
+  if t.departs_at > now() then
+    raise exception 'voyage:tour_not_started' using errcode = 'P0001';
+  end if;
+
+  -- Итоги по участницам: только известные статусы и только участницы этого тура
+  for v_key, v_value in select key, value #>> '{}' from jsonb_each(coalesce(p_outcomes, '{}'::jsonb)) loop
+    if v_value not in ('flown', 'late_drop', 'no_show', 'released') then
+      raise exception 'voyage:invalid_outcome' using errcode = '22023';
+    end if;
+    if v_key !~* '^[0-9a-f-]{36}$' then
+      raise exception 'voyage:invalid_outcomes' using errcode = '22023';
+    end if;
+    update public.partner_tour_members m
+       set status = v_value
+     where m.tour_id = t.id and m.resident_id = v_key::uuid and m.status = 'confirmed';
+  end loop;
+
+  update public.partner_tour_members m
+     set status = 'flown'
+   where m.tour_id = t.id and m.status = 'confirmed';
+
+  update public.partner_tours
+     set status = 'closed',
+         country_code = coalesce(v_country, country_code)
+   where id = t.id;
+
+  select count(*) filter (where m.status = 'flown')::int,
+         count(*) filter (where m.status in ('late_drop', 'no_show'))::int
+    into v_flown, v_dropped
+    from public.partner_tour_members m where m.tour_id = t.id;
+
+  select coalesce(sum(a.points_awarded), 0)::int into v_points
+    from public.resident_activities a where a.source_partner_tour_id = t.id;
+
+  return jsonb_build_object('ok', true, 'tour_id', t.id, 'status', 'closed',
+                            'flown', v_flown, 'dropped', v_dropped, 'points_awarded', v_points);
+end;
+$$;
+
+revoke all on function public.partner_close_tour(uuid, jsonb, text) from public, anon;
+grant execute on function public.partner_close_tour(uuid, jsonb, text) to authenticated, service_role;
+
+commit;
diff --git a/supabase/migrations/20261020093000_points_history.sql b/supabase/migrations/20261020093000_points_history.sql
new file mode 100644
index 0000000..5edcf22
--- /dev/null
+++ b/supabase/migrations/20261020093000_points_history.sql
@@ -0,0 +1,126 @@
+-- ════════════════════════════════════════════════════════════════════
+-- VOYAGE · Прозрачная история баллов резидентки
+-- supabase/migrations/20261020093000_points_history.sql
+--
+-- Требует 20261020092000_partner_tour_completion_points.sql
+-- (resident_activities.source_partner_tour_id).
+--
+--   get_my_points_history(p_limit, p_before, p_profile) → jsonb
+--     items    строки ledger (resident_score_events) новыми сверху, у каждой —
+--              откуда баллы: тур на карте (map_hubs), тусовка (global_events),
+--              тур менеджера (partner_tours), штамп страны, комбо, ачивка,
+--              корректировка клуба
+--     totals   сумма по категориям за всё время + общий итог
+--     next_before  курсор для «Показать ещё» (id последней строки) или null
+--
+--   p_profile — чужая история доступна только персоналу клуба.
+-- ════════════════════════════════════════════════════════════════════
+
+begin;
+
+create or replace function public.get_my_points_history(
+  p_limit integer default 30,
+  p_before bigint default null,
+  p_profile uuid default null
+)
+returns jsonb
+language plpgsql stable security definer
+set search_path to ''
+as $$
+declare
+  me uuid := auth.uid();
+  v_profile uuid := coalesce(p_profile, auth.uid());
+  v_limit integer := least(greatest(coalesce(p_limit, 30), 1), 100);
+  v_items jsonb;
+  v_totals jsonb;
+  v_count integer;
+  v_last bigint;
+begin
+  if me is null then
+    raise exception 'voyage:not_authenticated' using errcode = '28000';
+  end if;
+  if v_profile <> me and not coalesce(public.game_is_staff(), false) then
+    raise exception 'voyage:forbidden' using errcode = '42501';
+  end if;
+
+  with page as (
+    select e.*
+      from public.resident_score_events e
+     where e.profile_id = v_profile
+       and (p_before is null or e.id < p_before)
+     order by e.id desc
+     limit v_limit
+  ), described as (
+    select pg.id, pg.created_at, pg.category, pg.points, pg.reason, pg.activity_id,
+           case
+             when ap.id is not null then jsonb_build_object(
+               'kind', 'tour', 'ref_id', h.id,
+               'title', coalesce(h.name ->> 'RU', h.name ->> 'EN', ap.hub_id), 'title_i18n', h.name,
+               'region', h.region)
+             when ea.id is not null then jsonb_build_object(
+               'kind', 'party', 'ref_id', ge.id, 'title', ge.title, 'region', ge.region)
+             when a.source_partner_tour_id is not null then jsonb_build_object(
+               'kind', 'partner_tour', 'ref_id', a.source_partner_tour_id,
+               'title', coalesce(pt.city, a.source_label), 'project', pt.project_type)
+             when pg.metadata ? 'destination_id' then jsonb_build_object(
+               'kind', 'passport', 'ref_id', pg.metadata ->> 'destination_id',
+               'title', coalesce(gd.name, pg.metadata ->> 'destination_id'))
+             when pg.category = 'combo' then jsonb_build_object('kind', 'combo', 'title', pg.reason)
+             when pg.category = 'achievement' then jsonb_build_object('kind', 'achievement', 'title', pg.reason)
+             when pg.category = 'adjustment' then jsonb_build_object('kind', 'adjustment', 'title', pg.reason)
+             when a.id is not null then jsonb_build_object('kind', a.activity_type, 'title', a.source_label)
+             else jsonb_build_object('kind', pg.category, 'title', pg.reason)
+           end as source,
+           upper(coalesce(pg.metadata ->> 'country_code', a.destination_code)) as country_code,
+           case when a.id is not null then jsonb_build_object(
+             'commercial_value', a.commercial_value,
+             'reliability', a.reliability_snapshot,
+             'complexity', a.complexity_score,
+             'completed_at', a.completed_at
+           ) end as formula
+      from page pg
+      left join public.resident_activities a on a.id = pg.activity_id
+      left join public.applications ap on ap.id = a.source_application_id
+      left join public.map_hubs h on h.id = ap.hub_id
+      left join public.event_applications ea on ea.id = a.source_event_application_id
+      left join public.global_events ge on ge.id = ea.event_id
+      left join public.partner_tours pt on pt.id = a.source_partner_tour_id
+      left join public.game_destinations gd on gd.id = pg.metadata ->> 'destination_id'
+  )
+  select coalesce(jsonb_agg(jsonb_build_object(
+           'id', d.id, 'at', d.created_at, 'category', d.category, 'points', d.points,
+           'reason', d.reason, 'activity_id', d.activity_id, 'source', d.source,
+           'country_code', d.country_code, 'formula', d.formula
+         ) order by d.id desc), '[]'::jsonb),
+         count(*)::int,
+         min(d.id)
+    into v_items, v_count, v_last
+    from described d;
+
+  select jsonb_build_object(
+           'total', coalesce(sum(x.points), 0)::int,
+           'events', coalesce(sum(x.events), 0)::int,
+           'by_category', coalesce(jsonb_object_agg(x.category, x.points), '{}'::jsonb)
+         )
+    into v_totals
+    from (
+      select s.category, sum(s.points)::int as points, count(*)::int as events
+        from public.resident_score_events s
+       where s.profile_id = v_profile
+       group by s.category
+    ) x;
+
+  return jsonb_build_object(
+    'generated_at', now(),
+    'profile_id', v_profile,
+    'items', v_items,
+    'totals', v_totals,
+    'next_before', case when v_count = v_limit then v_last end
+  );
+end;
+$$;
+
+revoke all on function public.get_my_points_history(integer, bigint, uuid) from public, anon;
+grant execute on function public.get_my_points_history(integer, bigint, uuid) to authenticated, service_role;
+
+commit;
diff --git a/supabase/migrations/20261020094000_partner_live_pages.sql b/supabase/migrations/20261020094000_partner_live_pages.sql
new file mode 100644
index 0000000..e8dbc72
--- /dev/null
+++ b/supabase/migrations/20261020094000_partner_live_pages.sql
@@ -0,0 +1,671 @@
+-- ════════════════════════════════════════════════════════════════════
+-- VOYAGE · Кабинет менеджера без демо-данных: Кастинги, Манифест, Пульс,
+--          Ключи, Blacklist + сторона резидентки (мои туры, оценка менеджера)
+-- supabase/migrations/20261020094000_partner_live_pages.sql
+--
+-- Требует 20261020092000_partner_tour_completion_points.sql.
+--
+-- Каждая страница получает один RPC под SECURITY DEFINER — те же правила
+-- приватности, что в partner_command(): до рукопожатия резидентка видна
+-- менеджеру только слепым кодом, имя — по partner_can_reveal().
+--
+--   partner_castings_list()      все кастинги менеджера (админ — все) + слепые отклики
+--   partner_manifest()           все туры менеджера: состав, контракт, готовность, итог
+--   partner_pulse()              показатели, отзывы резиденток (анонимно), кого оценить
+--   partner_keys()               уровень Ключа и туры в зачёте
+--   partner_blacklist_list()     активные записи; админ — все, с доказательствами
+--   partner_blacklist_candidates()  кого менеджер может отправить на проверку
+--   partner_blacklist_report()   менеджер → заявка (status 'pending') на проверку клубом
+--   partner_blacklist_add()      админ → запись сразу
+--   partner_blacklist_review()   админ → подтвердить / апелляция / снять / срок
+--   partner_resident_tours()     резидентка: мои туры и оценка менеджера
+--
+-- 'pending' не попадает в partner_is_blacklisted(): пока клуб не проверил
+-- жалобу, резидентку ничто не блокирует.
+-- ════════════════════════════════════════════════════════════════════
+
+begin;
+
+/* ── Blacklist: статус pending, кто проверил ─────────────────────── */
+
+alter table public.partner_blacklist
+  add column if not exists reviewed_by uuid references public.profiles(id) on delete set null,
+  add column if not exists reviewed_at timestamptz,
+  add column if not exists tour_id uuid references public.partner_tours(id) on delete set null;
+
+alter table public.partner_blacklist drop constraint if exists partner_blacklist_status_check;
+alter table public.partner_blacklist add constraint partner_blacklist_status_check
+  check (status = any (array['pending', 'confirmed', 'appeal', 'revoked']::text[]));
+
+-- Число доказательств: непустые строки поля evidence (ссылки / описания файлов)
+create or replace function public.partner_evidence_count(p_evidence text)
+returns integer
+language sql immutable
+set search_path to ''
+as $$
+  select count(*)::int
+    from regexp_split_to_table(coalesce(p_evidence, ''), '\n') as line
+   where btrim(line) <> ''
+$$;
+
+/* ── Кастинги ───────────────────────────────────────────────────── */
+
+create or replace function public.partner_castings_list()
+returns jsonb
+language plpgsql stable security definer
+set search_path to ''
+as $$
+declare
+  me uuid := auth.uid();
+  v_admin boolean;
+begin
+  if me is null or not coalesce(public.has_role('manager', 'admin', 'owner'), false) then
+    raise exception 'voyage:forbidden' using errcode = '42501';
+  end if;
+  v_admin := coalesce(public.is_admin(), false);
+
+  return jsonb_build_object(
+    'generated_at', now(),
+    'castings', (
+      select coalesce(jsonb_agg(jsonb_build_object(
+               'id', c.id, 'city', c.city, 'project', c.project_type,
+               'starts_on', c.starts_on, 'ends_on', c.ends_on, 'slots', c.slots,
+               'closes_at', c.closes_at, 'stage', c.status,
+               'fee_amount', c.fee_amount, 'fee_currency', c.fee_currency,
+               'flight_paid_by', c.flight_paid_by, 'hotel_paid_by', c.hotel_paid_by,
+               'height_min', c.height_min, 'languages', to_jsonb(c.languages), 'brief', c.brief,
+               'tour_id', (select t.id from public.partner_tours t where t.casting_id = c.id
+                            order by t.created_at desc limit 1),
+               'fresh', (select count(*) from public.partner_casting_responses r
+                          where r.casting_id = c.id and r.status = 'ready'
+                            and r.created_at > c.manager_seen_at
+                            and not public.partner_is_blacklisted(r.resident_id)),
+               'responders', (
+                 select coalesce(jsonb_agg(jsonb_build_object(
+                          'code', public.partner_blind_code(r.id),
+                          'handshake', h.done,
+                          'resident_id', case when h.done or v_admin then r.resident_id end,
+                          'name', case when h.done or v_admin then public.partner_short_name(p.full_name) end,
+                          'snap_at', (select max(s.captured_at) from public.partner_live_snaps s
+                                       where s.resident_id = r.resident_id),
+                          'trusted', (select t.trusted from public.partner_resident_trust(r.resident_id) t)
+                        ) order by h.done desc, r.created_at), '[]'::jsonb)
+                 from public.partner_casting_responses r
+                 join public.profiles p on p.id = r.resident_id
+                 cross join lateral (
+                   select exists (
+                     select 1 from public.partner_tour_members m
+                     join public.partner_tours t on t.id = m.tour_id
+                     where t.casting_id = c.id and m.resident_id = r.resident_id
+                       and m.status in ('confirmed', 'flown')
+                   ) as done
+                 ) h
+                 where r.casting_id = c.id and r.status in ('ready', 'option', 'selected')
+                   and not public.partner_is_blacklisted(r.resident_id)
+               )
+             ) order by
+               case c.status when 'open' then 0 when 'shortlist' then 0 when 'closed' then 1 else 2 end,
+               c.closes_at), '[]'::jsonb)
+      from public.partner_castings c
+      where (c.manager_id = me or v_admin)
+        and (c.status in ('open', 'shortlist') or c.updated_at > now() - interval '180 days')
+    )
+  );
+end;
+$$;
+
+/* ── Манифест ───────────────────────────────────────────────────── */
+
+create or replace function public.partner_manifest()
+returns jsonb
+language plpgsql stable security definer
+set search_path to ''
+as $$
+declare
+  me uuid := auth.uid();
+  v_admin boolean;
+begin
+  if me is null or not coalesce(public.has_role('manager', 'admin', 'owner'), false) then
+    raise exception 'voyage:forbidden' using errcode = '42501';
+  end if;
+  v_admin := coalesce(public.is_admin(), false);
+
+  return jsonb_build_object(
+    'generated_at', now(),
+    'tours', (
+      select coalesce(jsonb_agg(jsonb_build_object(
+               'id', tr.id, 'city', tr.city, 'iata', tr.iata, 'project', tr.project_type,
+               'flight_no', tr.flight_no, 'departs_at', tr.departs_at, 'returns_at', tr.returns_at,
+               'status', tr.status, 'country_code', tr.country_code,
+               'readiness', case when tr.status <> 'confirmed' then null
+                                 when x.replacement is not null then 'replacement'
+                                 when ct.id is null or x.signed < x.crew + 1 then 'contract'
+                                 when x.no_docs > 0 then 'docs'
+                                 else 'confirmed' end,
+               'replacement', x.replacement,
+               'replacement_id', x.replacement_id,
+               'crew', (
+                 select coalesce(jsonb_agg(jsonb_build_object(
+                          'id', m.resident_id,
+                          'name', public.partner_short_name(p.full_name),
+                          'docs', m.docs_verified_at is not null,
+                          'signed', ct.id is not null and exists (
+                                      select 1 from public.partner_contract_signatures s
+                                      where s.contract_id = ct.id and s.signer_id = m.resident_id),
+                          'status', m.status
+                        ) order by m.joined_at), '[]'::jsonb)
+                 from public.partner_tour_members m
+                 join public.profiles p on p.id = m.resident_id
+                 where m.tour_id = tr.id
+                   and (m.status in ('confirmed', 'flown')
+                        or (tr.status = 'closed' and m.status in ('late_drop', 'no_show')))
+               ),
+               'contract', case when ct.id is null then null else jsonb_build_object(
+                             'version', ct.version, 'terms', ct.terms,
+                             'signed', x.signed, 'required', x.crew + 1,
+                             'sealed_at', case when x.signed >= x.crew + 1 then x.last_signed_at end
+                           ) end,
+               'outcome', case when tr.status = 'closed' then jsonb_build_object(
+                            'flown', x.flown, 'dropped', x.dropped) end
+             ) order by
+               case tr.status when 'in_tour' then 0 when 'confirmed' then 1 when 'closed' then 2 else 3 end,
+               case when tr.status in ('in_tour', 'confirmed') then extract(epoch from tr.departs_at)
+                    else -extract(epoch from tr.departs_at) end), '[]'::jsonb)
+      from public.partner_tours tr
+      left join lateral (
+        select c.id, c.version, c.terms from public.partner_contracts c
+        where c.tour_id = tr.id order by c.version desc limit 1
+      ) ct on true
+      cross join lateral (
+        select
+          (select count(*) from public.partner_tour_members m
+            where m.tour_id = tr.id and m.status in ('confirmed', 'flown'))::int as crew,
+          (select count(*) from public.partner_tour_members m
+            where m.tour_id = tr.id and m.status = 'confirmed' and m.docs_verified_at is null)::int as no_docs,
+          (select count(*) from public.partner_tour_members m
+            where m.tour_id = tr.id and m.status = 'flown')::int as flown,
+          (select count(*) from public.partner_tour_members m
+            where m.tour_id = tr.id and m.status in ('late_drop', 'no_show'))::int as dropped,
+          (select count(*) from public.partner_contract_signatures s
+            where s.contract_id = ct.id
+              and (s.signer_id = tr.manager_id or s.signer_id in (
+                    select m.resident_id from public.partner_tour_members m
+                    where m.tour_id = tr.id and m.status in ('confirmed', 'flown'))))::int as signed,
+          (select max(s.signed_at) from public.partner_contract_signatures s
+            where s.contract_id = ct.id) as last_signed_at,
+          rp.name as replacement,
+          rp.id as replacement_id
+        from (select 1) one
+        left join lateral (
+          select public.partner_short_name(p.full_name) as name, p.id
+          from public.partner_tour_members m
+          join public.profiles p on p.id = m.resident_id
+          where m.tour_id = tr.id and m.replaces_member_id is not null
+            and m.status in ('confirmed', 'flown')
+          order by m.joined_at desc limit 1
+        ) rp on true
+      ) x
+      where (tr.manager_id = me or v_admin)
+        and (tr.status in ('confirmed', 'in_tour') or tr.departs_at > now() - interval '24 months')
+    )
+  );
+end;
+$$;
+
+/* ── Пульс ──────────────────────────────────────────────────────── */
+
+create or replace function public.partner_pulse()
+returns jsonb
+language plpgsql stable security definer
+set search_path to ''
+as $$
+declare
+  me uuid := auth.uid();
+  st record;
+begin
+  if me is null or not coalesce(public.has_role('manager', 'admin', 'owner'), false) then
+    raise exception 'voyage:forbidden' using errcode = '42501';
+  end if;
+  select * into st from public.partner_manager_stats(me);
+
+  return jsonb_build_object(
+    'generated_at', now(),
+    'manager', jsonb_build_object(
+      'tier', st.tier, 'next_tier', st.next_tier,
+      'tours_done', st.tours_done, 'tours_for_next', st.tours_for_next,
+      'flown', st.flown, 'confirmed', st.confirmed,
+      'rating', st.rating, 'reviews', st.reviews
+    ),
+
+    -- 12 месяцев по месяцу вылета: долетели / сорвались
+    'months', (
+      select coalesce(jsonb_agg(jsonb_build_object(
+               'start', to_char(g.m, 'YYYY-MM-DD'),
+               'flown', coalesce(x.flown, 0), 'dropped', coalesce(x.dropped, 0)
+             ) order by g.m), '[]'::jsonb)
+      from generate_series(date_trunc('month', now()) - interval '11 months', date_trunc('month', now()), interval '1 month') g(m)
+      left join (
+        select date_trunc('month', tr.departs_at) as m,
+               count(*) filter (where mb.status = 'flown')::int as flown,
+               count(*) filter (where mb.status in ('late_drop', 'no_show'))::int as dropped
+        from public.partner_tour_members mb
+        join public.partner_tours tr on tr.id = mb.tour_id
+        where tr.manager_id = me and tr.status in ('in_tour', 'closed')
+        group by 1
+      ) x on x.m = g.m
+    ),
+
+    'replacements', (
+      select jsonb_build_object(
+        'total', count(*) filter (where mb.status in ('late_drop', 'no_show'))::int,
+        'closed', count(*) filter (where mb.status in ('late_drop', 'no_show') and exists (
+                    select 1 from public.partner_tour_members r
+                    where r.replaces_member_id = mb.id and r.status in ('confirmed', 'flown')))::int
+      )
+      from public.partner_tour_members mb
+      join public.partner_tours tr on tr.id = mb.tour_id
+      where tr.manager_id = me and tr.departs_at > now() - interval '12 months'
+    ),
+
+    'criteria', (
+      select coalesce(jsonb_agg(jsonb_build_object('key', x.tag, 'count', x.n) order by x.n desc), '[]'::jsonb)
+      from (
+        select t.tag, count(*)::int as n
+        from public.partner_reviews rv
+        cross join lateral unnest(rv.tags) as t(tag)
+        where rv.subject_id = me and rv.direction = 'resident_to_manager' and rv.status = 'published'
+        group by t.tag
+      ) x
+    ),
+
+    -- Отзывы резиденток — без автора: резидентка не должна бояться оценить
+    'feedback', (
+      select coalesce(jsonb_agg(jsonb_build_object(
+               'id', v.id, 'rating', v.rating, 'tags', to_jsonb(v.tags), 'quote', v.comment,
+               'city', v.city, 'project', v.project_type, 'at', v.created_at
+             ) order by v.created_at desc), '[]'::jsonb)
+      from (
+        select rv.id, rv.rating, rv.tags, rv.comment, rv.created_at, tr.city, tr.project_type
+        from public.partner_reviews rv
+        join public.partner_tours tr on tr.id = rv.tour_id
+        where rv.subject_id = me and rv.direction = 'resident_to_manager' and rv.status = 'published'
+        order by rv.created_at desc
+        limit 20
+      ) v
+    ),
+
+    -- Закрытые туры, где менеджер ещё не оценил участниц
+    'pending', (
+      select coalesce(jsonb_agg(jsonb_build_object(
+               'tour_id', tr.id, 'city', tr.city, 'project', tr.project_type,
+               'returned_at', coalesce(tr.returns_at, tr.closed_at, tr.departs_at),
+               'participants', ps.list
+             ) order by coalesce(tr.returns_at, tr.closed_at, tr.departs_at) desc), '[]'::jsonb)
+      from public.partner_tours tr
+      cross join lateral (
+        select coalesce(jsonb_agg(jsonb_build_object(
+                 'id', m.resident_id, 'name', public.partner_short_name(p.full_name),
+                 'status', m.status,
+                 'trust', (select to_jsonb(t) from public.partner_resident_trust(m.resident_id) t)
+               ) order by m.joined_at), '[]'::jsonb) as list,
+               count(*) as n
+        from public.partner_tour_members m
+        join public.profiles p on p.id = m.resident_id
+        where m.tour_id = tr.id and m.status in ('flown', 'late_drop', 'no_show')
+          and not exists (
+            select 1 from public.partner_reviews rv
+            where rv.tour_id = tr.id and rv.author_id = me and rv.subject_id = m.resident_id
+              and rv.direction = 'manager_to_resident')
+      ) ps
+      where tr.manager_id = me and tr.status = 'closed'
+        and coalesce(tr.closed_at, tr.departs_at) > now() - interval '60 days'
+        and ps.n > 0
+    ),
+
+    'crew', (
+      select coalesce(jsonb_agg(jsonb_build_object(
+               'id', c.resident_id, 'name', c.name, 'tours', c.tours, 'last_at', c.last_at,
+               'trust', (select to_jsonb(t) from public.partner_resident_trust(c.resident_id) t)
+             ) order by c.tours desc, c.last_at desc), '[]'::jsonb)
+      from (
+        select m.resident_id, public.partner_short_name(p.full_name) as name,
+               count(*)::int as tours, max(tr.departs_at) as last_at
+        from public.partner_tour_members m
+        join public.partner_tours tr on tr.id = m.tour_id
+        join public.profiles p on p.id = m.resident_id
+        where tr.manager_id = me and tr.status = 'closed' and m.status = 'flown'
+        group by m.resident_id, p.full_name
+        order by count(*) desc, max(tr.departs_at) desc
+        limit 6
+      ) c
+    )
+  );
+end;
+$$;
+
+/* ── Ключи ──────────────────────────────────────────────────────── */
+
+create or replace function public.partner_keys()
+returns jsonb
+language plpgsql stable security definer
+set search_path to ''
+as $$
+declare
+  me uuid := auth.uid();
+  st record;
+begin
+  if me is null or not coalesce(public.has_role('manager', 'admin', 'owner'), false) then
+    raise exception 'voyage:forbidden' using errcode = '42501';
+  end if;
+  select * into st from public.partner_manager_stats(me);
+
+  return jsonb_build_object(
+    'generated_at', now(),
+    'manager', jsonb_build_object(
+      'tier', st.tier, 'next_tier', st.next_tier,
+      'tours_done', st.tours_done, 'tours_for_next', st.tours_for_next,
+      'flown', st.flown, 'confirmed', st.confirmed,
+      'rating', st.rating, 'reviews', st.reviews
+    ),
+    'closed_total', (select count(*)::int from public.partner_tours t
+                      where t.manager_id = me and t.status = 'closed'),
+    'closed_year', (select count(*)::int from public.partner_tours t
+                     where t.manager_id = me and t.status = 'closed'
+                       and t.departs_at > now() - interval '12 months'),
+    'counted', (
+      select coalesce(jsonb_agg(jsonb_build_object(
+               'id', t.id, 'city', t.city, 'project', t.project_type,
+               'departs_at', t.departs_at, 'expires_at', t.departs_at + interval '12 months'
+             ) order by t.departs_at), '[]'::jsonb)
+      from public.partner_tours t
+      where t.manager_id = me and t.status = 'closed'
+        and t.departs_at > now() - interval '12 months'
+    )
+  );
+end;
+$$;
+
+/* ── Blacklist ──────────────────────────────────────────────────── */
+
+create or replace function public.partner_blacklist_list()
+returns jsonb
+language plpgsql stable security definer
+set search_path to ''
+as $$
+declare
+  me uuid := auth.uid();
+  v_admin boolean;
+begin
+  if me is null or not coalesce(public.has_role('manager', 'admin', 'owner'), false) then
+    raise exception 'voyage:forbidden' using errcode = '42501';
+  end if;
+  v_admin := coalesce(public.is_admin(), false);
+
+  return jsonb_build_object(
+    'generated_at', now(),
+    'is_admin', v_admin,
+    'entries', (
+      select coalesce(jsonb_agg(jsonb_build_object(
+               'id', b.id, 'code', public.partner_blind_code(b.id, 'R'),
+               'reason', b.reason, 'status', b.status, 'at', b.created_at, 'expires_at', b.expires_at,
+               'evidence', public.partner_evidence_count(b.evidence),
+               'resident_id', case when b.revealed then b.resident_id end,
+               'name', case when b.revealed then public.partner_short_name(p.full_name) end,
+               'mine', b.created_by = me,
+               -- Админу — подробности для решения
+               'evidence_text', case when v_admin then b.evidence end,
+               'reporter', case when v_admin then public.partner_short_name(rp.full_name) end,
+               'reviewed_at', case when v_admin then b.reviewed_at end
+             ) order by
+               case b.status when 'pending' then 0 when 'appeal' then 1 when 'confirmed' then 2 else 3 end,
+               b.created_at desc), '[]'::jsonb)
+      from (
+        select bl.*, public.partner_can_reveal(bl.resident_id) as revealed
+        from public.partner_blacklist bl
+        where (
+          v_admin
+          or (bl.status in ('confirmed', 'appeal') and (bl.expires_at is null or bl.expires_at > now()))
+          or (bl.created_by = me and bl.status = 'pending')
+        )
+        order by bl.created_at desc
+        limit 300
+      ) b
+      join public.profiles p on p.id = b.resident_id
+      left join public.profiles rp on rp.id = b.created_by
+    ),
+    'clean', not exists (
+      select 1 from public.partner_tour_members m
+      join public.partner_tours tr on tr.id = m.tour_id
+      where tr.manager_id = me and tr.status in ('confirmed', 'in_tour') and m.status = 'confirmed'
+        and public.partner_is_blacklisted(m.resident_id)
+    ) and not exists (
+      select 1 from public.partner_casting_responses r
+      join public.partner_castings c on c.id = r.casting_id
+      where c.manager_id = me and c.status in ('open', 'shortlist')
+        and r.status in ('option', 'selected')
+        and public.partner_is_blacklisted(r.resident_id)
+    )
+  );
+end;
+$$;
+
+-- Кого можно отправить на проверку: участницы туров менеджера (админ — все резидентки)
+create or replace function public.partner_blacklist_candidates()
+returns table(resident_id uuid, name text, last_tour_id uuid, last_city text, last_at timestamptz, last_status text)
+language plpgsql stable security definer
+set search_path to ''
+as $$
+declare
+  me uuid := auth.uid();
+  v_admin boolean;
+begin
+  if me is null or not coalesce(public.has_role('manager', 'admin', 'owner'), false) then
+    raise exception 'voyage:forbidden' using errcode = '42501';
+  end if;
+  v_admin := coalesce(public.is_admin(), false);
+
+  return query
+  select distinct on (p.id)
+         p.id, coalesce(public.partner_short_name(p.full_name), 'Резидентка'),
+         tr.id, tr.city, tr.departs_at, m.status
+    from public.profiles p
+    left join public.partner_tour_members m on m.resident_id = p.id
+    left join public.partner_tours tr on tr.id = m.tour_id and (v_admin or tr.manager_id = me)
+   where p.role = 'resident'
+     and (v_admin or tr.id is not null)
+     and not public.partner_is_blacklisted(p.id)
+   order by p.id, tr.departs_at desc nulls last
+   limit 1000;
+end;
+$$;
+
+create or replace function public.partner_blacklist_report(
+  p_resident uuid, p_reason text, p_evidence text, p_tour uuid default null
+)
+returns jsonb
+language plpgsql security definer
+set search_path to ''
+as $$
+declare
+  me uuid := auth.uid();
+  v_id uuid;
+  v_evidence text := nullif(btrim(coalesce(p_evidence, '')), '');
+begin
+  if me is null or not coalesce(public.has_role('manager', 'admin', 'owner'), false) then
+    raise exception 'voyage:forbidden' using errcode = '42501';
+  end if;
+  if p_reason not in ('no_show', 'fake_photos', 'fraud') then
+    raise exception 'voyage:invalid_reason' using errcode = '22023';
+  end if;
+  if v_evidence is null or length(v_evidence) < 10 or length(v_evidence) > 4000 then
+    raise exception 'voyage:evidence_required' using errcode = '22023';
+  end if;
+  -- Только бывшая участница своих туров (админ — любая резидентка)
+  if not public.partner_can_reveal(p_resident)
+     or not exists (select 1 from public.profiles p where p.id = p_resident and p.role = 'resident') then
+    raise exception 'voyage:forbidden_resident' using errcode = '42501';
+  end if;
+  if p_tour is not null and not exists (
+    select 1 from public.partner_tours t
+    join public.partner_tour_members m on m.tour_id = t.id and m.resident_id = p_resident
+    where t.id = p_tour and (t.manager_id = me or coalesce(public.is_admin(), false))
+  ) then
+    raise exception 'voyage:forbidden_tour' using errcode = '42501';
+  end if;
+  if exists (
+    select 1 from public.partner_blacklist b
+    where b.resident_id = p_resident and b.created_by = me and b.status = 'pending'
+  ) then
+    raise exception 'voyage:report_already_pending' using errcode = 'P0001';
+  end if;
+
+  insert into public.partner_blacklist (resident_id, reason, status, evidence, created_by, tour_id)
+  values (p_resident, p_reason, 'pending', v_evidence, me, p_tour)
+  returning id into v_id;
+
+  return jsonb_build_object('ok', true, 'id', v_id, 'status', 'pending',
+                            'code', public.partner_blind_code(v_id, 'R'));
+end;
+$$;
+
+create or replace function public.partner_blacklist_add(
+  p_resident uuid, p_reason text, p_evidence text, p_expires_at timestamptz default null
+)
+returns jsonb
+language plpgsql security definer
+set search_path to ''
+as $$
+declare
+  me uuid := auth.uid();
+  v_id uuid;
+begin
+  if me is null or not coalesce(public.is_admin(), false) then
+    raise exception 'voyage:forbidden' using errcode = '42501';
+  end if;
+  if p_reason not in ('no_show', 'fake_photos', 'fraud') then
+    raise exception 'voyage:invalid_reason' using errcode = '22023';
+  end if;
+  if not exists (select 1 from public.profiles p where p.id = p_resident and p.role = 'resident') then
+    raise exception 'voyage:resident_not_found' using errcode = 'P0002';
+  end if;
+
+  insert into public.partner_blacklist (resident_id, reason, status, evidence, created_by, expires_at, reviewed_by, reviewed_at)
+  values (p_resident, p_reason, 'confirmed', nullif(btrim(coalesce(p_evidence, '')), ''), me, p_expires_at, me, now())
+  returning id into v_id;
+
+  return jsonb_build_object('ok', true, 'id', v_id, 'status', 'confirmed');
+end;
+$$;
+
+-- p_expires_at: null — не менять; p_clear_expiry = true — бессрочно
+create or replace function public.partner_blacklist_review(
+  p_id uuid, p_status text, p_expires_at timestamptz default null, p_clear_expiry boolean default false
+)
+returns jsonb
+language plpgsql security definer
+set search_path to ''
+as $$
+declare
+  me uuid := auth.uid();
+  b public.partner_blacklist%rowtype;
+begin
+  if me is null or not coalesce(public.is_admin(), false) then
+    raise exception 'voyage:forbidden' using errcode = '42501';
+  end if;
+  if p_status not in ('confirmed', 'appeal', 'revoked') then
+    raise exception 'voyage:invalid_status' using errcode = '22023';
+  end if;
+
+  select * into b from public.partner_blacklist where id = p_id for update;
+  if not found then raise exception 'voyage:entry_not_found' using errcode = 'P0002'; end if;
+
+  update public.partner_blacklist
+     set status = p_status,
+         expires_at = case
+           when p_clear_expiry then null
+           when p_expires_at is not null then p_expires_at
+           -- Подтверждённая неявка без срока — 12 месяцев, как при прямом добавлении
+           when p_status = 'confirmed' and b.status = 'pending' and b.reason = 'no_show' and b.expires_at is null
+             then now() + interval '12 months'
+           else expires_at end,
+         reviewed_by = me,
+         reviewed_at = now()
+   where id = p_id;
+
+  return jsonb_build_object('ok', true, 'id', p_id, 'status', p_status);
+end;
+$$;
+
+/* ── Резидентка: мои туры и оценка менеджера ────────────────────── */
+
+create or replace function public.partner_resident_tours()
+returns jsonb
+language plpgsql stable security definer
+set search_path to ''
+as $$
+declare
+  me uuid := auth.uid();
+begin
+  if me is null or not exists (select 1 from public.profiles p where p.id = me and p.role = 'resident') then
+    raise exception 'voyage:resident_only' using errcode = '42501';
+  end if;
+
+  return jsonb_build_object(
+    'generated_at', now(),
+    'tours', (
+      select coalesce(jsonb_agg(jsonb_build_object(
+               'id', tr.id, 'city', tr.city, 'project', tr.project_type,
+               'departs_at', tr.departs_at, 'returns_at', tr.returns_at,
+               'tour_status', tr.status, 'my_status', m.status,
+               'manager', (select jsonb_build_object(
+                             'name', public.partner_short_name(mp.full_name),
+                             'tier', st.tier, 'rating', st.rating)
+                           from public.profiles mp
+                           cross join lateral public.partner_manager_stats(tr.manager_id) st
+                           where mp.id = tr.manager_id),
+               'points', (select a.points_awarded from public.resident_activities a
+                           where a.source_partner_member_id = m.id),
+               'can_review', public.partner_can_review(tr.id, tr.manager_id, 'resident_to_manager')
+                             and not exists (select 1 from public.partner_reviews rv
+                                             where rv.tour_id = tr.id and rv.author_id = me
+                                               and rv.direction = 'resident_to_manager'),
+               'my_review', (select jsonb_build_object('rating', rv.rating, 'status', rv.status, 'at', rv.created_at)
+                              from public.partner_reviews rv
+                             where rv.tour_id = tr.id and rv.author_id = me
+                               and rv.direction = 'resident_to_manager'
+                             order by rv.created_at desc limit 1),
+               'manager_id', tr.manager_id
+             ) order by tr.departs_at desc), '[]'::jsonb)
+      from public.partner_tour_members m
+      join public.partner_tours tr on tr.id = m.tour_id
+      where m.resident_id = me and tr.status <> 'cancelled'
+    )
+  );
+end;
+$$;
+
+/* ── Права ──────────────────────────────────────────────────────── */
+
